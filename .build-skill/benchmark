        "Exact per-query phases (per cell x per chunk aggregate):",
        f"  match-matrix build: {profile['query_match_matrix_ms']:.3f} ms",
        f"  int8 idx construction: {profile['query_idx_construct_ms']:.3f} ms",
        f"  doubling scan: {profile['query_doubling_scan_ms']:.3f} ms",
        "",
        "Carry loops:",
        f"  phase-1 cell-1: {profile['carry_loop_p1_c1_ms']:.3f} ms, "
        f"ops={profile['carry_loop_p1_c1_ops']}",
        f"  phase-2 cell-0: {profile['carry_loop_p2_c0_ms']:.3f} ms, "
        f"ops={profile['carry_loop_p2_c0_ops']}",
        f"  phase-2 cell-1: {profile['carry_loop_p2_c1_ms']:.3f} ms, "
        f"ops={profile['carry_loop_p2_c1_ops']}",
        f"  total carry ops: {total_carry_ops}",
        f"  total carry time: {total_carry_ms:.3f} ms",
        f"  assumed launch latency: {profile['assumed_launch_latency_us']:.1f} us/launch",
        f"  estimated launch-latency time: {launch_latency_ms:.3f} ms",
        f"  estimated launch-latency share of carry time: "
        f"{profile['estimated_launch_latency_share_carry_pct']:.1f}%",
        f"  estimated launch-latency share of exact total: "
        f"{profile['estimated_launch_latency_share_exact_pct']:.1f}%",
        "",
        "Output assembly:",
        f"  base write: {profile['base_write_ms']:.3f} ms",
        f"  output assembly: {profile['output_assembly_ms']:.3f} ms",
        "",
        "V2 reference phases:",
        f"  gathers: {profile['v2_gathers_ms']:.3f} ms",
        f"  fills: {profile['v2_fills_ms']:.3f} ms",
        f"  searchsorted: {profile['v2_searchsorted_ms']:.3f} ms",
        f"  output assembly: {profile['v2_output_assembly_ms']:.3f} ms",
        "=" * 60,
    ]

    text = "\n".join(lines)
    print(text)

    json_text = json.dumps(profile, indent=2)
    for line in json_text.splitlines():
        print(f"PROFILE {line}")

    log_dir = os.environ.get("BUILD_SKILL_LOG_DIR")
    if log_dir:
        os.makedirs(log_dir, exist_ok=True)
        iteration_id = profile["iteration_id"]
        text_path = os.path.join(log_dir, f"profile-{iteration_id}.txt")
        jsonl_path = os.path.join(log_dir, f"profile-{iteration_id}.jsonl")
        with open(text_path, "w") as f:
            f.write(text + "\n")
        with open(jsonl_path, "w") as f:
            for line in json_text.splitlines():
                f.write(f"PROFILE {line}\n")


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--dev", action="store_true", help="Reduce Tier B scale/reps for local dev."
    )
    parser.add_argument(
        "--profile-exact",
        action="store_true",
        help="Run exact-variant phase profiler.",
    )
    parser.add_argument(
        "--profile-exact-v2",
        action="store_true",
        dest="profile_exact_v2",
        help="Run exact-v2 fast-path phase profiler.",
    )
    args = parser.parse_args()

    if args.profile_exact:
        profile = run_profile_exact(dev=args.dev)
        _print_profile(profile)
        return

    if args.profile_exact_v2:
        profile = run_profile_exact_v2(dev=args.dev)
        _print_profile_exact_v2(profile)
        return

    iteration_id = os.environ.get("BUILD_SKILL_ITERATION_ID", "iter-002")

    self_check = run_self_check()
    _log("Self-check passed.")

    tier_a = run_tier_a()
    _log("Tier A passed.")

    tier_b = run_tier_b(dev=args.dev)
    _log("Tier B completed.")

    result = {
        "iteration_id": iteration_id,
        "seed": SEED,
        "self_check": {
            "endpoint_count": self_check["endpoint_count"],
            "ok": True,
            "fingerprint": self_check["bins"],
            "phase2_active": self_check["phase2_active"],
        },
        "tierA": tier_a,
        "tierB": tier_b,
    }

    json_line = json.dumps(result)
    print(json_line)

    log_dir = os.environ.get("BUILD_SKILL_LOG_DIR")
    if log_dir:
        os.makedirs(log_dir, exist_ok=True)
        log_path = os.path.join(log_dir, f"benchmark-{iteration_id}.json")
        with open(log_path, "w") as f:
            f.write(json_line + "\n")


if __name__ == "__main__":
    main()
