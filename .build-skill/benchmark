        if info["endpoint_count"] != 0:
            _log(f"Tier A reduced endpoint count nonzero: {info['endpoint_count']}")
            sys.exit(1)
        t0 = time.perf_counter()
        golden = main_reference(
            e2c=e2c,
            z_me=z_me,
            z_mc=z_mc,
            z_ifc=z_ifc,
            flat_idx=flat_idx,
            topography=topography,
            nlev=nlev,
            horizontal_start=hs,
            horizontal_start_1=hs1,
        )
        main_ref_seconds = time.perf_counter() - t0

    variants = {}
    variant_results = {}
    for name, fn in [
        ("numpy-baseline", compute_zdiff_gradp),
        ("numpy-candidate", compute_zdiff_gradp_v2),
        ("numpy-exact", compute_zdiff_gradp_exact),
        ("numpy-exact2", compute_zdiff_gradp_exact_v2),
        ("numpy-exact3", compute_zdiff_gradp_exact_v3),
        ("numpy-dispatch", compute_zdiff_gradp_dispatch),
    ]:
        result = run_variant(fn, e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1)
        variant_results[name] = result
        mismatches_zdiff = count_mismatches_close(result[0], golden[0])
        mismatches_vert = count_mismatches(result[1], golden[1])
        variants[name] = {"mismatches_vs_golden": mismatches_zdiff + mismatches_vert}
        if mismatches_zdiff or mismatches_vert:
            _log(f"Tier A {name} mismatch: zdiff={mismatches_zdiff}, vert={mismatches_vert}")
            sys.exit(1)

    # Defensive reference-scan check: independent Python scan == exact2 machinery.
    reference_outputs = _reference_scan_outputs(
        e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1
    )
    ref_vs_exact2_zdiff = count_mismatches_close(
        reference_outputs[0], variant_results["numpy-exact2"][0]
    )
    ref_vs_exact2_vert = count_mismatches(reference_outputs[1], variant_results["numpy-exact2"][1])
    if ref_vs_exact2_zdiff or ref_vs_exact2_vert:
        _log(
            f"Tier A reference scan mismatch vs numpy-exact2: "
            f"zdiff={ref_vs_exact2_zdiff}, vert={ref_vs_exact2_vert}"
        )
        sys.exit(1)
    variants["numpy-exact2"]["reference_scan_mismatches"] = ref_vs_exact2_zdiff + ref_vs_exact2_vert

    try:
        import cupy as cp

        e2c_cu, z_me_cu, z_mc_cu, z_ifc_cu, flat_idx_cu, topography_cu = _to_namespace(
            [e2c, z_me, z_mc, z_ifc, flat_idx, topography], cp
        )
        for name, fn in [
            ("cupy-baseline", compute_zdiff_gradp),
            ("cupy-candidate", compute_zdiff_gradp_v2),
            ("cupy-exact", compute_zdiff_gradp_exact),
            ("cupy-exact2", compute_zdiff_gradp_exact_v2),
            ("cupy-exact3", compute_zdiff_gradp_exact_v3),
            ("cupy-dispatch", compute_zdiff_gradp_dispatch),
        ]:
            result = run_variant(
                fn, e2c_cu, z_me_cu, z_mc_cu, z_ifc_cu, flat_idx_cu, topography_cu, nlev, hs, hs1
            )
            mismatches_zdiff = count_mismatches_close(result[0], golden[0])
            mismatches_vert = count_mismatches(result[1], golden[1])
            variants[name] = {"mismatches_vs_golden": mismatches_zdiff + mismatches_vert}
            if mismatches_zdiff or mismatches_vert:
                _log(f"Tier A {name} mismatch: zdiff={mismatches_zdiff}, vert={mismatches_vert}")
                sys.exit(1)
            if name == "cupy-exact3":
                exact3_vs_exact2_zdiff = count_mismatches_close(
                    result[0], variant_results["numpy-exact2"][0]
                )
                exact3_vs_exact2_vert = count_mismatches(
                    result[1], variant_results["numpy-exact2"][1]
                )
                if exact3_vs_exact2_zdiff or exact3_vs_exact2_vert:
                    _log(
                        f"Tier A cupy-exact3 mismatch vs numpy-exact2: "
                        f"zdiff={exact3_vs_exact2_zdiff}, vert={exact3_vs_exact2_vert}"
                    )
                    sys.exit(1)
                variants[name]["mismatches_vs_numpy_exact2"] = (
                    exact3_vs_exact2_zdiff + exact3_vs_exact2_vert
                )
    except ImportError:
        pass

    endpoint_forcing = run_endpoint_forcing()
    if (
        not endpoint_forcing["candidate_matches_golden"]
        or not endpoint_forcing["exact_matches_golden"]
        or not endpoint_forcing["exact2_matches_golden"]
        or not endpoint_forcing["exact3_matches_golden"]
        or not endpoint_forcing["baseline_diverges"]
    ):
        _log(f"Endpoint forcing failed: {endpoint_forcing}")
        sys.exit(1)

    probes = [
        run_weird_input_probe(build_p1_interior_tie_inputs, "P1"),
        run_weird_input_probe(build_p2_zero_thickness_inputs, "P2"),
        run_weird_input_probe(build_p3_e3_violation_inputs, "P3"),
    ]

    result = {
        "endpoint_count": info["endpoint_count"],
        "fingerprint": info["bins"],
        "main_reference_seconds": float(main_ref_seconds),
        "variants": variants,
        "endpoint_forcing": endpoint_forcing,
        "weird_input_probes": probes,
    }
    if scale_change is not None:
        result["scale_change"] = scale_change
    return result


def _time_variant(fn, args, array_ns, timed_reps):
    times = []
    for _ in range(timed_reps):
        _sync(array_ns)
        t0 = time.perf_counter()
        run_variant(fn, *args)
        _sync(array_ns)
        t1 = time.perf_counter()
        times.append((t1 - t0) * 1000.0)
    return times


def run_tier_b(dev: bool):
    if dev:
        nedges, ncells, nlev = 49152, 32768, 60
        timed_reps = 5
    else:
        nedges, ncells, nlev = 491520, 327680, 60
        timed_reps = 25

    e2c, z_me, z_mc, z_ifc, flat_idx, topography, hs, hs1 = build_inputs(nedges, ncells, nlev, SEED)
    z_aux2 = z_aux2_from(topography, e2c)
    info = fingerprint_info(flat_idx, nlev, z_me, z_aux2, z_ifc, e2c, hs1, nedges)
    if info["endpoint_count"] != 0:
        _log(f"Tier B endpoint count nonzero: {info['endpoint_count']}")
        sys.exit(1)

    backends = [("numpy", np)]
    try:
        import cupy as cp

        backends.append(("cupy", cp))
    except ImportError:
        pass

    # Per-backend inputs and variant definitions.
    backend_inputs = {}
    variant_defs = []
    for backend_name, array_ns in backends:
        e2c_b, z_me_b, z_mc_b, z_ifc_b, flat_idx_b, topography_b = _to_namespace(
            [e2c, z_me, z_mc, z_ifc, flat_idx, topography], array_ns
        )
        backend_inputs[backend_name] = (
            array_ns,
            e2c_b,
            z_me_b,
            z_mc_b,
            z_ifc_b,
            flat_idx_b,
            topography_b,
        )
        variant_defs.append(
            (f"{backend_name}-baseline", compute_zdiff_gradp, False),
        )
        variant_defs.append(
            (f"{backend_name}-candidate", compute_zdiff_gradp_v2, True),
        )
        variant_defs.append((f"{backend_name}-exact", compute_zdiff_gradp_exact, True))
        variant_defs.append((f"{backend_name}-exact2", compute_zdiff_gradp_exact_v2, True))
        variant_defs.append((f"{backend_name}-exact3", compute_zdiff_gradp_exact_v3, True))
        variant_defs.append((f"{backend_name}-dispatch", compute_zdiff_gradp_dispatch, True))

    # Bitwise equality check before timing (validation default ON is fine here).
    results = {}
    for name, fn, _ in variant_defs:
        backend_name = name.split("-")[0]
        args = backend_inputs[backend_name][1:]
        results[name] = run_variant(fn, *args, nlev, hs, hs1)

    baseline_by_backend = {}
    for name, _, _ in variant_defs:
        backend_name = name.split("-")[0]
        if "-baseline" in name:
            baseline_by_backend[backend_name] = results[name]

    for name, result in results.items():
        backend_name = name.split("-")[0]
        baseline = baseline_by_backend[backend_name]
        mismatches_zdiff = count_mismatches_close(result[0], baseline[0])
        mismatches_vert = count_mismatches(result[1], baseline[1])
        if mismatches_zdiff or mismatches_vert:
            _log(
                f"Tier B {name} mismatch vs baseline: zdiff={mismatches_zdiff}, vert={mismatches_vert}"
            )
            sys.exit(1)

    # Standard Tier-B inputs are E3-valid, so exact_v2 must use the fast path.
    # Standard Tier-B inputs are E3-valid, so exact_v2 and dispatch must use the fast path.
    if _zdiff_mod._LAST_EXACT_V2_PATH != "fast":
        _log("Tier B exact_v2 did not record fast path")
        sys.exit(1)
    if _zdiff_mod._LAST_DISPATCH_PATH != "fast":
        _log("Tier B dispatch did not route to v2 fast path")
        sys.exit(1)
    if _zdiff_mod._LAST_EXACT_V3_PATH != "fast":
        _log("Tier B exact_v3 did not record fast path")
        sys.exit(1)
    # Timed validation on/off matrix.
    timings: dict[str, dict[str, list[float]]] = {
        name: {"on": [], "off": []} for name, _, _ in variant_defs
    }

    for mode_idx, mode in enumerate(("off", "on")):
        os.environ["ICON4PY_VALIDATE_ZDIFF_GRADP"] = "0" if mode == "off" else "1"

        # Per-mode warmup: 3 reps per variant before any timed reps.
        for name, fn, has_modes in variant_defs:
            if mode_idx == 1 and not has_modes:
                continue
            backend_name = name.split("-")[0]
            array_ns, *args = backend_inputs[backend_name]
            base_args = (*args, nlev, hs, hs1)
            for _ in range(3):
                run_variant(fn, *base_args)
            _sync(array_ns)

        # Timed reps: round-robin across variants within this mode.
        for _ in range(timed_reps):
            for name, fn, has_modes in variant_defs:
                if mode_idx == 1 and not has_modes:
                    continue
                backend_name = name.split("-")[0]
                array_ns, *args = backend_inputs[backend_name]
                base_args = (*args, nlev, hs, hs1)
                _sync(array_ns)
                t0 = time.perf_counter()
                run_variant(fn, *base_args)
                _sync(array_ns)
                t1 = time.perf_counter()
                timings[name][mode].append((t1 - t0) * 1000.0)

    # Baseline has no validation modes; its on/off entries are identical.
    for name, _, has_modes in variant_defs:
        if not has_modes:
            timings[name]["on"] = timings[name]["off"][:]
    variants = {}
    for name, _, has_modes in variant_defs:
        backend_name = name.split("-")[0]
        baseline = baseline_by_backend[backend_name]
        mismatches_zdiff = count_mismatches_close(results[name][0], baseline[0])
        mismatches_vert = count_mismatches(results[name][1], baseline[1])
        times_on = timings[name]["on"]
        times_off = timings[name]["off"]
        median_on = float(np.median(times_on))
        median_off = float(np.median(times_off))
        variants[name] = {
            "validation_on": {"median_ms": median_on, "min_ms": float(np.min(times_on))},
            "validation_off": {"median_ms": median_off, "min_ms": float(np.min(times_off))},
            "validation_overhead_ms": median_on - median_off,
            "validation_overhead_ratio": median_on / median_off if median_off > 0 else float("inf"),
            "mismatches_vs_baseline": mismatches_zdiff + mismatches_vert,
            "path": (
                _zdiff_mod._LAST_EXACT_V2_PATH
                if "exact2" in name
                else (
                    _zdiff_mod._LAST_EXACT_V3_PATH
                    if "exact3" in name
                    else (_zdiff_mod._LAST_DISPATCH_PATH if "dispatch" in name else None)
                )
            ),
        }

    return {
        "endpoint_count": info["endpoint_count"],
        "variants": variants,
    }


def _profile_exact_query_succ(z_ifc_k, v, array_ns):
    """Replicate _exact_query_succ with per-phase wall timing."""
    _chunk, nlev_p1 = z_ifc_k.shape
    nlev = nlev_p1 - 1

    a_idx = array_ns.arange(nlev, dtype=array_ns.int64)
    z_ifc_k = z_ifc_k.astype(array_ns.float64)
    v = v.astype(array_ns.float64)

    _sync(array_ns)
    t0 = time.perf_counter()
    upper = z_ifc_k[:, None, :-1]
    lower = z_ifc_k[:, None, 1:]
    qv = v[:, :, None]
    bracket = (upper >= qv) & (qv >= lower)
    unconditional = a_idx[None, None, :] == (nlev - 1)
    idx = array_ns.where(bracket | unconditional, a_idx[None, None, :], nlev)
    _sync(array_ns)
    match_matrix_ms = (time.perf_counter() - t0) * 1000.0

    _sync(array_ns)
    t0 = time.perf_counter()
    if nlev <= 127:
        idx = idx.astype(array_ns.int8)
    elif nlev <= 32767:
        idx = idx.astype(array_ns.int16)
    else:
        raise ValueError(
            f"compute_zdiff_gradp_exact successor tables support nlev <= 32767, got {nlev}."
        )
    _sync(array_ns)
    idx_construct_ms = (time.perf_counter() - t0) * 1000.0

    _sync(array_ns)
    t0 = time.perf_counter()
    S = idx.copy()
    step = 1
    while step < nlev:
        S[..., :-step] = array_ns.minimum(S[..., :-step], S[..., step:])
        step *= 2
    _sync(array_ns)
    doubling_scan_ms = (time.perf_counter() - t0) * 1000.0

    return S, {
        "match_matrix_ms": match_matrix_ms,
        "idx_construct_ms": idx_construct_ms,
        "doubling_scan_ms": doubling_scan_ms,
    }


def _profile_exact_carry_loop(succ, fi, active, array_ns):
    """Replicate _exact_carry_loop with operation counting and timing."""
    _sync(array_ns)
    t0 = time.perf_counter()
    chunk, _nq, nlev = succ.shape
    single_query = _nq == 1
    t = fi.astype(array_ns.int64).copy()
    jk1_out = array_ns.empty((chunk, nlev), dtype=array_ns.int64)
    ops = 0
    for jk in range(nlev):
        src = succ[:, 0:1, :] if single_query else succ[:, jk : jk + 1, :]
        jk1 = array_ns.take_along_axis(src, t[:, None, None], axis=2)[:, 0, 0]
        ops += 1
        jk1_out[:, jk] = jk1
        ops += 1
        t = array_ns.where(active[:, jk], jk1, t)
        ops += 1
    _sync(array_ns)
    elapsed_ms = (time.perf_counter() - t0) * 1000.0
    return jk1_out, {"time_ms": elapsed_ms, "ops": ops}


def _profile_exact_variant(
    e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1, chunk_size=None
):
    """Profile exact variant phase times without modifying product code."""
    array_ns = data_alloc.array_namespace(z_mc)
    nedges = e2c.shape[0]

    z_aux1 = array_ns.maximum(topography[e2c[:, 0]], topography[e2c[:, 1]])
    z_aux2 = z_aux1 - 5.0

    fi = flat_idx.astype(array_ns.int64)
    e2c_0 = e2c[:, 0].astype(array_ns.int64)
    e2c_1 = e2c[:, 1].astype(array_ns.int64)

    z_ifc_e0 = z_ifc[e2c_0, :]
    z_ifc_e1 = z_ifc[e2c_1, :]

    jk_idx = array_ns.arange(nlev, dtype=array_ns.int64)[None, :]
    edge_hs_mask = array_ns.arange(nedges, dtype=array_ns.int64) >= hs
    edge_hs1_mask = array_ns.arange(nedges, dtype=array_ns.int64) >= hs1
    valid_jk = (jk_idx > fi[:, None]) & edge_hs_mask[:, None]
    phase2_active = valid_jk & (z_me < z_aux2[:, None]) & edge_hs1_mask[:, None]

    if chunk_size is None:
        mem_per_edge = nlev * 2 * (nlev + 1)
        chunk_size = max(1, min(nedges, (256 * 1024 * 1024) // mem_per_edge))

    timers = {
        "query_match_matrix_ms": 0.0,
        "query_idx_construct_ms": 0.0,
        "query_doubling_scan_ms": 0.0,
        "carry_loop_p1_c1_ms": 0.0,
        "carry_loop_p1_c1_ops": 0,
        "carry_loop_p2_c0_ms": 0.0,
        "carry_loop_p2_c0_ops": 0,
        "carry_loop_p2_c1_ms": 0.0,
        "carry_loop_p2_c1_ops": 0,
        "base_write_ms": 0.0,
        "output_assembly_ms": 0.0,
    }

    _sync(array_ns)
    t0 = time.perf_counter()
    zdiff_gradp = array_ns.zeros_like(z_mc[e2c])
    zdiff_gradp[hs:, :, :] = array_ns.expand_dims(z_me, axis=1)[hs:, :, :] - z_mc[e2c][hs:, :, :]
    vertoffset_gradp = array_ns.zeros((nedges, 2, nlev), dtype=gtx.int32)
    _sync(array_ns)
    timers["base_write_ms"] = (time.perf_counter() - t0) * 1000.0

    for start in range(0, nedges, chunk_size):
        end = min(start + chunk_size, nedges)
        chunk = slice(start, end)
        z_ifc_k0 = z_ifc_e0[chunk, :].astype(array_ns.float64)
        z_ifc_k1 = z_ifc_e1[chunk, :].astype(array_ns.float64)
        z_me_c = z_me[chunk, :].astype(array_ns.float64)
        fi_c = fi[chunk]
        valid_jk_c = valid_jk[chunk, :]

        # Phase 1, cell 0: fresh scan at every jk.
        succ0, t = _profile_exact_query_succ(z_ifc_k0, z_me_c, array_ns)
        timers["query_match_matrix_ms"] += t["match_matrix_ms"]
        timers["query_idx_construct_ms"] += t["idx_construct_ms"]
        timers["query_doubling_scan_ms"] += t["doubling_scan_ms"]

        jk1_0 = _exact_phase1_cell0(succ0, fi_c, array_ns)
        z_mc_e0 = z_mc[e2c_0[chunk]]

        _sync(array_ns)
        t0 = time.perf_counter()
        zdiff_gradp[chunk, 0, :] = array_ns.where(
            valid_jk_c,
            z_me_c - array_ns.take_along_axis(z_mc_e0, jk1_0, axis=1),
            zdiff_gradp[chunk, 0, :],
        )
        vertoffset_gradp[chunk, 0, :] = array_ns.where(
            valid_jk_c,
            (jk1_0 - jk_idx).astype(gtx.int32),
            vertoffset_gradp[chunk, 0, :],
        )
        _sync(array_ns)
        timers["output_assembly_ms"] += (time.perf_counter() - t0) * 1000.0

        # Phase 1, cell 1: carry t = jk_start between jk iterations.
        succ1, t = _profile_exact_query_succ(z_ifc_k1, z_me_c, array_ns)
        timers["query_match_matrix_ms"] += t["match_matrix_ms"]
        timers["query_idx_construct_ms"] += t["idx_construct_ms"]
        timers["query_doubling_scan_ms"] += t["doubling_scan_ms"]

        jk1_1, t_carry = _profile_exact_carry_loop(succ1, fi_c, valid_jk_c, array_ns)
        timers["carry_loop_p1_c1_ms"] += t_carry["time_ms"]
        timers["carry_loop_p1_c1_ops"] += t_carry["ops"]
        z_mc_e1 = z_mc[e2c_1[chunk]]

        _sync(array_ns)
        t0 = time.perf_counter()
        zdiff_gradp[chunk, 1, :] = array_ns.where(
            valid_jk_c,
            z_me_c - array_ns.take_along_axis(z_mc_e1, jk1_1, axis=1),
            zdiff_gradp[chunk, 1, :],
        )
        vertoffset_gradp[chunk, 1, :] = array_ns.where(
            valid_jk_c,
            (jk1_1 - jk_idx).astype(gtx.int32),
            vertoffset_gradp[chunk, 1, :],
        )
        _sync(array_ns)
        timers["output_assembly_ms"] += (time.perf_counter() - t0) * 1000.0

        # Phase 2: applies to edges [hs1:] only.
        if hs1 < nedges:
            phase2_active_c = phase2_active[chunk, :]
            z_aux2_v = z_aux2[chunk, None].astype(array_ns.float64)

            succ2_0, t = _profile_exact_query_succ(z_ifc_k0, z_aux2_v, array_ns)
            timers["query_match_matrix_ms"] += t["match_matrix_ms"]
            timers["query_idx_construct_ms"] += t["idx_construct_ms"]
            timers["query_doubling_scan_ms"] += t["doubling_scan_ms"]

            jk1_aux_0, t_carry = _profile_exact_carry_loop(succ2_0, fi_c, phase2_active_c, array_ns)
            timers["carry_loop_p2_c0_ms"] += t_carry["time_ms"]
            timers["carry_loop_p2_c0_ops"] += t_carry["ops"]

            _sync(array_ns)
            t0 = time.perf_counter()
            zdiff_gradp[chunk, 0, :] = array_ns.where(
                phase2_active_c,
                z_aux2_v - array_ns.take_along_axis(z_mc_e0, jk1_aux_0, axis=1),
                zdiff_gradp[chunk, 0, :],
            )
            vertoffset_gradp[chunk, 0, :] = array_ns.where(
                phase2_active_c,
                (jk1_aux_0 - jk_idx).astype(gtx.int32),
                vertoffset_gradp[chunk, 0, :],
            )
            _sync(array_ns)
            timers["output_assembly_ms"] += (time.perf_counter() - t0) * 1000.0

            succ2_1, t = _profile_exact_query_succ(z_ifc_k1, z_aux2_v, array_ns)
            timers["query_match_matrix_ms"] += t["match_matrix_ms"]
            timers["query_idx_construct_ms"] += t["idx_construct_ms"]
            timers["query_doubling_scan_ms"] += t["doubling_scan_ms"]

            jk1_aux_1, t_carry = _profile_exact_carry_loop(succ2_1, fi_c, phase2_active_c, array_ns)
            timers["carry_loop_p2_c1_ms"] += t_carry["time_ms"]
            timers["carry_loop_p2_c1_ops"] += t_carry["ops"]

            _sync(array_ns)
            t0 = time.perf_counter()
            zdiff_gradp[chunk, 1, :] = array_ns.where(
                phase2_active_c,
                z_aux2_v - array_ns.take_along_axis(z_mc_e1, jk1_aux_1, axis=1),
                zdiff_gradp[chunk, 1, :],
            )
            vertoffset_gradp[chunk, 1, :] = array_ns.where(
                phase2_active_c,
                (jk1_aux_1 - jk_idx).astype(gtx.int32),
                vertoffset_gradp[chunk, 1, :],
            )
            _sync(array_ns)
            timers["output_assembly_ms"] += (time.perf_counter() - t0) * 1000.0

    return zdiff_gradp, vertoffset_gradp, timers, chunk_size


def _profile_v2_variant(e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1):
    """Profile v2 variant phase times for reference."""
    array_ns = data_alloc.array_namespace(z_mc)
    nedges = e2c.shape[0]

    timers = {
        "gathers_ms": 0.0,
        "fills_ms": 0.0,
        "searchsorted_ms": 0.0,
        "output_assembly_ms": 0.0,
    }

    _sync(array_ns)
    t0 = time.perf_counter()
    z_aux1 = array_ns.maximum(topography[e2c[:, 0]], topography[e2c[:, 1]])
    z_aux2 = z_aux1 - 5.0
    fi = flat_idx.astype(array_ns.int64)
    e2c_0 = e2c[:, 0].astype(array_ns.int64)
    e2c_1 = e2c[:, 1].astype(array_ns.int64)
    z_ifc_asc = z_ifc[:, ::-1].copy()
    z_ifc_e0 = z_ifc_asc[e2c_0]
    z_ifc_e1 = z_ifc_asc[e2c_1]
    z_mc_e0 = z_mc[e2c_0]
    z_mc_e1 = z_mc[e2c_1]
    _sync(array_ns)
    timers["gathers_ms"] = (time.perf_counter() - t0) * 1000.0

    _sync(array_ns)
    t0 = time.perf_counter()
    zdiff_gradp = array_ns.zeros_like(z_mc[e2c])
    vertoffset_gradp = array_ns.zeros((nedges, 2, nlev), dtype=gtx.int32)
    fill_high = (
        array_ns.max(array_ns.stack([z_ifc_e0.max(), z_ifc_e1.max(), z_me.max(), z_aux2.max()]))
        + 1.0
    )
    fill_low = (
        array_ns.min(array_ns.stack([z_ifc_e0.min(), z_ifc_e1.min(), z_me.min(), z_aux2.min()]))
        - 1.0
    )
    jk_idx = array_ns.arange(nlev, dtype=array_ns.int64)[None, :]
    fi_sliced = fi[hs:]
    z_ifc_mask = array_ns.arange(nlev + 1, dtype=array_ns.int64)[None, :] >= (
        nlev + 1 - fi_sliced[:, None]
    )
    z_me_mask = array_ns.arange(nlev, dtype=array_ns.int64)[None, :] <= fi_sliced[:, None]
    z_ifc_e0_m = array_ns.where(z_ifc_mask, fill_high, z_ifc_e0[hs:])
    z_ifc_e1_m = array_ns.where(z_ifc_mask, fill_high, z_ifc_e1[hs:])
    z_me_m = array_ns.where(z_me_mask, fill_low, z_me[hs:])
    valid_jk = jk_idx > fi_sliced[:, None]
    _sync(array_ns)
    timers["fills_ms"] = (time.perf_counter() - t0) * 1000.0

    _sync(array_ns)
    t0 = time.perf_counter()
    pos_0 = _batched_searchsorted_v2(z_ifc_e0_m, z_me_m, array_ns)
    jk1_0 = array_ns.clip(nlev - pos_0, fi_sliced[:, None], nlev - 1)
    pos_1 = _batched_searchsorted_v2(z_ifc_e1_m, z_me_m, array_ns)
    jk1_1 = array_ns.clip(nlev - pos_1, fi_sliced[:, None], nlev - 1)
    _sync(array_ns)
    timers["searchsorted_ms"] = (time.perf_counter() - t0) * 1000.0

    _sync(array_ns)
    t0 = time.perf_counter()
    zdiff_gradp[hs:, :, :] = array_ns.expand_dims(z_me, axis=1)[hs:, :, :] - z_mc[e2c][hs:, :, :]
    zdiff_gradp[hs:, 0, :] = array_ns.where(
        valid_jk,
        z_me[hs:] - array_ns.take_along_axis(z_mc_e0[hs:], jk1_0.astype(array_ns.int64), axis=1),
        zdiff_gradp[hs:, 0, :],
    )
    vertoffset_gradp[hs:, 0, :] = array_ns.where(
        valid_jk,
        (jk1_0 - jk_idx).astype(gtx.int32),
        vertoffset_gradp[hs:, 0, :],
    )
    zdiff_gradp[hs:, 1, :] = array_ns.where(
        valid_jk,
        z_me[hs:] - array_ns.take_along_axis(z_mc_e1[hs:], jk1_1.astype(array_ns.int64), axis=1),
        zdiff_gradp[hs:, 1, :],
    )
    vertoffset_gradp[hs:, 1, :] = array_ns.where(
        valid_jk,
        (jk1_1 - jk_idx).astype(gtx.int32),
        vertoffset_gradp[hs:, 1, :],
    )
    _sync(array_ns)
    timers["output_assembly_ms"] = (time.perf_counter() - t0) * 1000.0

    if hs1 < nedges:
        _sync(array_ns)
        t0 = time.perf_counter()
        fi_sliced1 = fi[hs1:]
        z_aux2_v = z_aux2[hs1:, None]
        z_ifc_mask1 = array_ns.arange(nlev + 1, dtype=array_ns.int64)[None, :] >= (
            nlev + 1 - fi_sliced1[:, None]
        )
        z_ifc_e0_m1 = array_ns.where(z_ifc_mask1, fill_high, z_ifc_e0[hs1:])
        z_ifc_e1_m1 = array_ns.where(z_ifc_mask1, fill_high, z_ifc_e1[hs1:])
        _sync(array_ns)
        timers["fills_ms"] += (time.perf_counter() - t0) * 1000.0

        _sync(array_ns)
        t0 = time.perf_counter()
        pos_aux_0 = _batched_searchsorted_v2(z_ifc_e0_m1, z_aux2_v, array_ns)
        jk1_aux_0 = array_ns.clip(nlev - pos_aux_0, fi_sliced1[:, None], nlev - 1)
        jk1_aux_0 = array_ns.where(
            pos_aux_0 >= (nlev + 1 - fi_sliced1)[:, None],
            nlev - 1,
            jk1_aux_0,
        )
        pos_aux_1 = _batched_searchsorted_v2(z_ifc_e1_m1, z_aux2_v, array_ns)
        jk1_aux_1 = array_ns.clip(nlev - pos_aux_1, fi_sliced1[:, None], nlev - 1)
        jk1_aux_1 = array_ns.where(
            pos_aux_1 >= (nlev + 1 - fi_sliced1)[:, None],
            nlev - 1,
            jk1_aux_1,
        )
        _sync(array_ns)
        timers["searchsorted_ms"] += (time.perf_counter() - t0) * 1000.0

        _sync(array_ns)
        t0 = time.perf_counter()
        phase2_mask = valid_jk[(hs1 - hs) :] & (z_me[hs1:] < z_aux2_v)
        zdiff_gradp[hs1:, 0, :] = array_ns.where(
            phase2_mask,
            z_aux2_v
            - array_ns.take_along_axis(z_mc_e0[hs1:], jk1_aux_0.astype(array_ns.int64), axis=1),
            zdiff_gradp[hs1:, 0, :],
        )
        vertoffset_gradp[hs1:, 0, :] = array_ns.where(
            phase2_mask,
            (jk1_aux_0 - jk_idx).astype(gtx.int32),
            vertoffset_gradp[hs1:, 0, :],
        )
        zdiff_gradp[hs1:, 1, :] = array_ns.where(
            phase2_mask,
            z_aux2_v
            - array_ns.take_along_axis(z_mc_e1[hs1:], jk1_aux_1.astype(array_ns.int64), axis=1),
            zdiff_gradp[hs1:, 1, :],
        )
        vertoffset_gradp[hs1:, 1, :] = array_ns.where(
            phase2_mask,
            (jk1_aux_1 - jk_idx).astype(gtx.int32),
            vertoffset_gradp[hs1:, 1, :],
        )
        _sync(array_ns)
        timers["output_assembly_ms"] += (time.perf_counter() - t0) * 1000.0

    return zdiff_gradp, vertoffset_gradp, timers


def _profile_exact_v2_query_succ(z_ifc_k, v, array_ns, *, _sample_intermediates=False):
    """Replicate _exact_query_succ with per-phase wall timing.

    Phases match the user's requested decomposition:
      (a) match-bitflow boolean mask build
      (b) idx = where(M, arange, large)
      (c) doubling suffix-minimum scan
      (d) astype to int8/int16
    """
    _chunk, nlev_p1 = z_ifc_k.shape
    nlev = nlev_p1 - 1

    a_idx = array_ns.arange(nlev, dtype=array_ns.int64)

    z_ifc_k_f64 = z_ifc_k.astype(array_ns.float64)
    v_f64 = v.astype(array_ns.float64)

    upper = z_ifc_k_f64[:, None, :-1]
    lower = z_ifc_k_f64[:, None, 1:]
    qv = v_f64[:, :, None]

    _sync(array_ns)
    t0 = time.perf_counter()
    bracket = (upper >= qv) & (qv >= lower)
    unconditional = a_idx[None, None, :] == (nlev - 1)
    M = bracket | unconditional
    _sync(array_ns)
    match_matrix_ms = (time.perf_counter() - t0) * 1000.0

    if nlev <= 127:
        idx_dtype = array_ns.int8
    elif nlev <= 32767:
        idx_dtype = array_ns.int16
    else:
        raise ValueError(
            f"compute_zdiff_gradp_exact successor tables support nlev <= 32767, got {nlev}."
        )
    _sync(array_ns)
    t0 = time.perf_counter()
    a_idx_typed = a_idx.astype(idx_dtype)
    fill_large = array_ns.asarray(nlev, dtype=idx_dtype)
    _sync(array_ns)
    dtype_downcast_ms = (time.perf_counter() - t0) * 1000.0

    _sync(array_ns)
    t0 = time.perf_counter()
    idx = array_ns.where(M, a_idx_typed[None, None, :], fill_large)
    _sync(array_ns)
    idx_construct_ms = (time.perf_counter() - t0) * 1000.0

    _sync(array_ns)
    t0 = time.perf_counter()
    S = idx.copy()
    step = 1
    while step < nlev:
        S[..., :-step] = array_ns.minimum(S[..., :-step], S[..., step:])
        step *= 2
    _sync(array_ns)
    doubling_scan_ms = (time.perf_counter() - t0) * 1000.0

    timings = {
        "match_matrix_ms": match_matrix_ms,
        "idx_construct_ms": idx_construct_ms,
        "doubling_scan_ms": doubling_scan_ms,
        "dtype_downcast_ms": dtype_downcast_ms,
    }
    if _sample_intermediates:
        samples = {
            "query_match_mask": _sample_array("query_match_mask", M),
            "query_idx": _sample_array("query_idx", idx),
            "query_succ": _sample_array("query_succ", S),
        }
        return S, timings, samples
    return S, timings


def _profile_exact_v2_variant(e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1):
    """Profile compute_zdiff_gradp_exact_v2 fast path with per-phase timing."""
    array_ns = data_alloc.array_namespace(z_mc)
    nedges = e2c.shape[0]

    timers = {
        k: 0.0
        for k in [
            "input_gathers_ms",
            "base_write_ms",
            "p1c0_match_matrix_ms",
            "p1c0_idx_construct_ms",
            "p1c0_doubling_scan_ms",
            "p1c0_dtype_downcast_ms",
            "p1c0_jk1_gather_ms",
            "p1c1_match_matrix_ms",
            "p1c1_idx_construct_ms",
            "p1c1_doubling_scan_ms",
            "p1c1_dtype_downcast_ms",
            "p1c1_jk1_gather_ms",
            "p2c0_match_matrix_ms",
            "p2c0_idx_construct_ms",
            "p2c0_doubling_scan_ms",
            "p2c0_dtype_downcast_ms",
            "p2c0_jk1_gather_ms",
            "p2c1_match_matrix_ms",
            "p2c1_idx_construct_ms",
            "p2c1_doubling_scan_ms",
            "p2c1_dtype_downcast_ms",
            "p2c1_jk1_gather_ms",
            "output_assembly_ms",
        ]
    }

    _sync(array_ns)
    t0 = time.perf_counter()
    z_aux1 = array_ns.maximum(topography[e2c[:, 0]], topography[e2c[:, 1]])
    z_aux2 = z_aux1 - 5.0
    fi = flat_idx.astype(array_ns.int64)
    e2c_0 = e2c[:, 0].astype(array_ns.int64)
    e2c_1 = e2c[:, 1].astype(array_ns.int64)
    z_ifc_e0 = z_ifc[e2c_0, :]
    z_ifc_e1 = z_ifc[e2c_1, :]
    _sync(array_ns)
    timers["input_gathers_ms"] = (time.perf_counter() - t0) * 1000.0

    _sync(array_ns)
    t0 = time.perf_counter()
    zdiff_gradp = array_ns.zeros_like(z_mc[e2c])
    zdiff_gradp[hs:, :, :] = array_ns.expand_dims(z_me, axis=1)[hs:, :, :] - z_mc[e2c][hs:, :, :]
    vertoffset_gradp = array_ns.zeros((nedges, 2, nlev), dtype=gtx.int32)
    _sync(array_ns)
    timers["base_write_ms"] = (time.perf_counter() - t0) * 1000.0

    jk_idx = array_ns.arange(nlev, dtype=array_ns.int64)[None, :]
    edge_hs_mask = array_ns.arange(nedges, dtype=array_ns.int64) >= hs
    edge_hs1_mask = array_ns.arange(nedges, dtype=array_ns.int64) >= hs1
    valid_jk = (jk_idx > fi[:, None]) & edge_hs_mask[:, None]
    phase2_active = valid_jk & (z_me < z_aux2[:, None]) & edge_hs1_mask[:, None]

    itemsize = 1 if nlev <= 127 else 2
    chunk_size = _exact_v2_chunk_size(nlev, itemsize)

    def _time_jk1_and_assemble(prefix, chunk, S, fi_c, active_c, z_mc_ec, query_v, cell):
        _sync(array_ns)
        t0 = time.perf_counter()
        jk1 = _exact_phase1_cell0(S, fi_c, array_ns).astype(array_ns.int64)
        _sync(array_ns)
        timers[f"{prefix}_jk1_gather_ms"] += (time.perf_counter() - t0) * 1000.0

        _sync(array_ns)
        t0 = time.perf_counter()
        zdiff_gradp[chunk, cell, :] = array_ns.where(
            active_c,
            query_v - array_ns.take_along_axis(z_mc_ec, jk1, axis=1),
            zdiff_gradp[chunk, cell, :],
        )
        vertoffset_gradp[chunk, cell, :] = array_ns.where(
            active_c,
            (jk1 - jk_idx).astype(gtx.int32),
            vertoffset_gradp[chunk, cell, :],
        )
        _sync(array_ns)
        timers["output_assembly_ms"] += (time.perf_counter() - t0) * 1000.0

    # Phase 1, cell 0: no carry.
    p1c0_chunks = 0
    for chunk in _exact_v2_edge_chunks(hs, nedges, chunk_size):
        p1c0_chunks += 1
        z_ifc_k0 = z_ifc_e0[chunk, :].astype(array_ns.float64)
        z_me_c = z_me[chunk, :].astype(array_ns.float64)
        fi_c = fi[chunk]
        valid_jk_c = valid_jk[chunk, :]
        z_mc_e0 = z_mc[e2c_0[chunk]]
        S0, qt = _profile_exact_v2_query_succ(z_ifc_k0, z_me_c, array_ns)
        timers["p1c0_match_matrix_ms"] += qt["match_matrix_ms"]
        timers["p1c0_idx_construct_ms"] += qt["idx_construct_ms"]
        timers["p1c0_doubling_scan_ms"] += qt["doubling_scan_ms"]
        timers["p1c0_dtype_downcast_ms"] += qt["dtype_downcast_ms"]
        _time_jk1_and_assemble("p1c0", chunk, S0, fi_c, valid_jk_c, z_mc_e0, z_me_c, 0)

    # Phase 1, cell 1: fast path uses fresh scan.
    p1c1_chunks = 0
    for chunk in _exact_v2_edge_chunks(hs, nedges, chunk_size):
        p1c1_chunks += 1
        z_ifc_k1 = z_ifc_e1[chunk, :].astype(array_ns.float64)
        z_me_c = z_me[chunk, :].astype(array_ns.float64)
        fi_c = fi[chunk]
        valid_jk_c = valid_jk[chunk, :]
        z_mc_e1 = z_mc[e2c_1[chunk]]
        S1, qt = _profile_exact_v2_query_succ(z_ifc_k1, z_me_c, array_ns)
        timers["p1c1_match_matrix_ms"] += qt["match_matrix_ms"]
        timers["p1c1_idx_construct_ms"] += qt["idx_construct_ms"]
        timers["p1c1_doubling_scan_ms"] += qt["doubling_scan_ms"]
        timers["p1c1_dtype_downcast_ms"] += qt["dtype_downcast_ms"]
        _time_jk1_and_assemble("p1c1", chunk, S1, fi_c, valid_jk_c, z_mc_e1, z_me_c, 1)

    # Phase 2: edges [hs1:] only.
    p2c0_chunks = 0
    p2c1_chunks = 0
    if hs1 < nedges:
        z_aux2_v_full = z_aux2[:, None].astype(array_ns.float64)
        for chunk in _exact_v2_edge_chunks(hs1, nedges, chunk_size):
            p2c0_chunks += 1
            p2c1_chunks += 1
            z_ifc_k0 = z_ifc_e0[chunk, :].astype(array_ns.float64)
            z_ifc_k1 = z_ifc_e1[chunk, :].astype(array_ns.float64)
            fi_c = fi[chunk]
            phase2_active_c = phase2_active[chunk, :]
            z_aux2_v = z_aux2_v_full[chunk]
            z_mc_e0 = z_mc[e2c_0[chunk]]
            z_mc_e1 = z_mc[e2c_1[chunk]]
            S2_0, qt = _profile_exact_v2_query_succ(z_ifc_k0, z_aux2_v, array_ns)
            timers["p2c0_match_matrix_ms"] += qt["match_matrix_ms"]
            timers["p2c0_idx_construct_ms"] += qt["idx_construct_ms"]
            timers["p2c0_doubling_scan_ms"] += qt["doubling_scan_ms"]
            timers["p2c0_dtype_downcast_ms"] += qt["dtype_downcast_ms"]
            _time_jk1_and_assemble("p2c0", chunk, S2_0, fi_c, phase2_active_c, z_mc_e0, z_aux2_v, 0)
            S2_1, qt = _profile_exact_v2_query_succ(z_ifc_k1, z_aux2_v, array_ns)
            timers["p2c1_match_matrix_ms"] += qt["match_matrix_ms"]
            timers["p2c1_idx_construct_ms"] += qt["idx_construct_ms"]
            timers["p2c1_doubling_scan_ms"] += qt["doubling_scan_ms"]
            timers["p2c1_dtype_downcast_ms"] += qt["dtype_downcast_ms"]
            _time_jk1_and_assemble("p2c1", chunk, S2_1, fi_c, phase2_active_c, z_mc_e1, z_aux2_v, 1)

    return (
        zdiff_gradp,
        vertoffset_gradp,
        timers,
        chunk_size,
        {
            "p1c0_chunks": p1c0_chunks,
            "p1c1_chunks": p1c1_chunks,
            "p2c0_chunks": p2c0_chunks,
            "p2c1_chunks": p2c1_chunks,
        },
    )


def _sample_array(name, arr):
    return {
        "name": name,
        "dtype": str(arr.dtype),
        "shape": arr.shape,
        "size": int(arr.size),
        "nbytes": int(arr.nbytes),
    }


def _mem_info(array_ns):
    if array_ns.__name__ == "cupy":
        try:
            pool = array_ns.get_default_memory_pool()
            return {"used_bytes": int(pool.used_bytes), "total_bytes": int(pool.total_bytes)}
        except Exception:
            return {"used_bytes": None, "total_bytes": None}
    return {"used_bytes": None, "total_bytes": None}


def run_profile_exact_v2(*, dev: bool):
    """Run exact-v2 fast-path phase profiler at Tier B scale."""
    if dev:
        nedges, ncells, nlev = 49152, 32768, 60
    else:
        nedges, ncells, nlev = 491520, 327680, 60

    e2c, z_me, z_mc, z_ifc, flat_idx, topography, hs, hs1 = build_inputs(nedges, ncells, nlev, SEED)
    z_aux2 = z_aux2_from(topography, e2c)
    info = fingerprint_info(flat_idx, nlev, z_me, z_aux2, z_ifc, e2c, hs1, nedges)
    if info["endpoint_count"] != 0:
        _log(f"Profile exact-v2 endpoint count nonzero: {info['endpoint_count']}")
        sys.exit(1)

    backend_name = "numpy"
    try:
        import cupy as cp

        backend_name = "cupy"
        array_ns = cp
        e2c_b, z_me_b, z_mc_b, z_ifc_b, flat_idx_b, topography_b = _to_namespace(
            [e2c, z_me, z_mc, z_ifc, flat_idx, topography], cp
        )
    except ImportError:
        array_ns = np
        e2c_b, z_me_b, z_mc_b, z_ifc_b, flat_idx_b, topography_b = (
            e2c,
            z_me,
            z_mc,
            z_ifc,
            flat_idx,
            topography,
        )

    # Total exact_v2 time with validation off (standard benchmark timing mode).
    prev_validate = os.environ.get("ICON4PY_VALIDATE_ZDIFF_GRADP")
    os.environ["ICON4PY_VALIDATE_ZDIFF_GRADP"] = "0"
    _sync(array_ns)
    t0 = time.perf_counter()
    exact_v2_result = compute_zdiff_gradp_exact_v2(
        e2c=e2c_b,
        z_me=z_me_b,
        z_mc=z_mc_b,
        z_ifc=z_ifc_b,
        flat_idx=flat_idx_b,
        topography=topography_b,
        nlev=nlev,
        horizontal_start=hs,
        horizontal_start_1=hs1,
    )
    _sync(array_ns)
    exact_v2_total_ms = (time.perf_counter() - t0) * 1000.0
    if prev_validate is None:
        os.environ.pop("ICON4PY_VALIDATE_ZDIFF_GRADP", None)
    else:
        os.environ["ICON4PY_VALIDATE_ZDIFF_GRADP"] = prev_validate
    if _zdiff_mod._LAST_EXACT_V2_PATH != "fast":
        _log("Profile exact-v2: exact_v2 did not use fast path")
        sys.exit(1)
    # Phased reconstruction.
    (
        zdiff_gradp_prof,
        vertoffset_gradp_prof,
        timers,
        chunk_size_used,
        chunk_counts,
    ) = _profile_exact_v2_variant(
        e2c_b, z_me_b, z_mc_b, z_ifc_b, flat_idx_b, topography_b, nlev, hs, hs1
    )

    exact_v2_matches = np.allclose(
        _to_numpy(exact_v2_result[0]), _to_numpy(zdiff_gradp_prof)
    ) and np.array_equal(_to_numpy(exact_v2_result[1]), _to_numpy(vertoffset_gradp_prof))
    if not exact_v2_matches:
        _log("Profile exact-v2: phased result does not match compute_zdiff_gradp_exact_v2")
        sys.exit(1)

    # Full-width _exact_query_succ timings for comparison (one per table).
    z_ifc_e0_full = z_ifc_b[e2c_b[:, 0].astype(array_ns.int64), :]
    z_ifc_e1_full = z_ifc_b[e2c_b[:, 1].astype(array_ns.int64), :]

    def _try_full_width(fn, label):
        try:
            _sync(array_ns)
            t0 = time.perf_counter()
            result = fn()
            _sync(array_ns)
            return result, (time.perf_counter() - t0) * 1000.0, None
        except Exception as exc:
            _log(f"Profile exact-v2: full-width {label} failed: {exc}")
            return None, None, str(exc)

    p1c0_result, p1c0_full_ms, _ = _try_full_width(
        lambda: _profile_exact_v2_query_succ(
            z_ifc_e0_full, z_me_b, array_ns, _sample_intermediates=True
        ),
        "p1c0",
    )
    if p1c0_result is not None:
        S_p1c0_full, _p1c0_timings, p1c0_samples = p1c0_result
    else:
        S_p1c0_full = None
        p1c0_samples = None
    S_p1c1_full, p1c1_full_ms, _ = _try_full_width(
        lambda: _profile_exact_v2_query_succ(z_ifc_e1_full, z_me_b, array_ns),
        "p1c1",
    )

    z_aux2_full = (array_ns.maximum(topography_b[e2c_b[:, 0]], topography_b[e2c_b[:, 1]]) - 5.0)[
        :, None
    ]

    S_p2c0_full, p2c0_full_ms, _ = _try_full_width(
        lambda: _profile_exact_v2_query_succ(z_ifc_e0_full[hs1:], z_aux2_full[hs1:], array_ns),
        "p2c0",
    )
    S_p2c1_full, p2c1_full_ms, _ = _try_full_width(
        lambda: _profile_exact_v2_query_succ(z_ifc_e1_full[hs1:], z_aux2_full[hs1:], array_ns),
        "p2c1",
    )

    sampled_arrays = [
        _sample_array("z_ifc_e0", z_ifc_e0_full),
        _sample_array("z_mc[e2c]", z_mc_b[e2c_b]),
        _sample_array("z_me", z_me_b),
    ]
    if S_p1c0_full is not None:
        sampled_arrays.append(_sample_array("p1c0_full_succ", S_p1c0_full))
    if isinstance(p1c0_samples, dict):
        sampled_arrays.extend(p1c0_samples.values())
    peak_mem = _mem_info(array_ns)
    with contextlib.suppress(Exception):
        del S_p1c0_full, S_p1c1_full, S_p2c0_full, S_p2c1_full
    _sync(array_ns)
    peak_mem_after_free = _mem_info(array_ns)
    total_query_ms = (
        timers["p1c0_match_matrix_ms"]
        + timers["p1c0_idx_construct_ms"]
        + timers["p1c0_doubling_scan_ms"]
        + timers["p1c0_dtype_downcast_ms"]
        + timers["p1c1_match_matrix_ms"]
        + timers["p1c1_idx_construct_ms"]
        + timers["p1c1_doubling_scan_ms"]
        + timers["p1c1_dtype_downcast_ms"]
        + timers["p2c0_match_matrix_ms"]
        + timers["p2c0_idx_construct_ms"]
        + timers["p2c0_doubling_scan_ms"]
        + timers["p2c0_dtype_downcast_ms"]
        + timers["p2c1_match_matrix_ms"]
        + timers["p2c1_idx_construct_ms"]
        + timers["p2c1_doubling_scan_ms"]
        + timers["p2c1_dtype_downcast_ms"]
    )

    return {
        "iteration_id": os.environ.get("BUILD_SKILL_ITERATION_ID", "iter-002"),
        "mode": "profile-exact-v2",
        "dev": dev,
        "backend": backend_name,
        "nedges": nedges,
        "ncells": ncells,
        "nlev": nlev,
        "chunk_size": chunk_size_used,
        "chunk_counts": chunk_counts,
        "exact_v2_total_ms": exact_v2_total_ms,
        "exact_v2_matches_profile": bool(exact_v2_matches),
        "full_width_query_ms": {
            "p1c0": p1c0_full_ms,
            "p1c1": p1c1_full_ms,
            "p2c0": p2c0_full_ms,
            "p2c1": p2c1_full_ms,
        },
        "peak_memory_bytes": peak_mem,
        "peak_memory_after_free_bytes": peak_mem_after_free,
        "sampled_arrays": sampled_arrays,
        "total_query_ms": total_query_ms,
        **timers,
    }


