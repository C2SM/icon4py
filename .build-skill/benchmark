        topography=topography,
        nlev=nlev,
        horizontal_start=hs,
        horizontal_start_1=hs1,
    )
    main_ref_seconds = time.perf_counter() - t0

    scale_change = None
    if main_ref_seconds > TIER_A_MAIN_REF_CAP_SECONDS:
        nedges_before = nedges
        nedges = nedges // 2
        ncells = ncells // 2
        scale_change = {"nedges_before": nedges_before, "nedges_after": nedges}
        e2c, z_me, z_mc, z_ifc, flat_idx, topography, hs, hs1 = build_inputs(
            nedges, ncells, nlev, SEED
        )
        z_aux2 = z_aux2_from(topography, e2c)
