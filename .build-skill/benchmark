def build_inputs(nedges, ncells, nlev, seed):
    rng = np.random.default_rng(seed)

    walk = 1500.0 + np.cumsum(rng.normal(0.0, 20.0, ncells))
    topography = np.clip(walk, 0.0, 3000.0)

    raw = np.exp(-np.arange(nlev + 1, dtype=np.float64) / 240.0)
    profile = (raw - raw[-1]) / (raw[0] - raw[-1])
    thick_base = -np.diff(profile)
    thick = thick_base[None, :] * rng.lognormal(0.0, 0.15, (ncells, nlev))
    thick /= thick.sum(axis=1, keepdims=True)

    z_ifc = np.empty((ncells, nlev + 1), dtype=np.float64)
    z_ifc[:, nlev] = topography
    for k in range(nlev - 1, -1, -1):
        z_ifc[:, k] = z_ifc[:, k + 1] + (FULL_HEIGHT - topography) * thick[:, k]

    c0 = np.mod(np.arange(nedges), ncells)
    c1 = (c0 + 1) % ncells
    cliff = rng.random(nedges) < 0.25
    c1[cliff] = rng.integers(0, ncells, size=int(cliff.sum()))
    e2c = np.stack([c0, c1], axis=1)

    alpha = rng.uniform(0.3, 0.7, nedges)
    c_lin_e = np.stack([alpha, 1.0 - alpha], axis=1)

    z_mc = 0.5 * (z_ifc[:, :-1] + z_ifc[:, 1:])
    z_me = np.sum(z_mc[e2c] * c_lin_e[:, :, None], axis=1)

    k_lev = np.arange(nlev + 1, dtype=np.int32)
    flat_idx = compute_flat_max_idx(e2c=e2c, z_me=z_me, z_ifc=z_ifc, k_lev=k_lev)

    hs = int(0.2 * nedges)
    hs1 = int(0.5 * nedges)

    return e2c, z_me, z_mc, z_ifc, flat_idx, topography, hs, hs1


def _endpoint_count(e2c, z_ifc, flat_idx, z_aux2, hs1, nedges, nlev):
    count = 0
    for je in range(hs1, nedges):
        for c in (0, 1):
            if z_aux2[je] > z_ifc[e2c[je, c], flat_idx[je]]:
                count += 1
    return count


def main_reference(
    *,
    e2c,
    z_me,
    z_mc,
    z_ifc,
    flat_idx,
    topography,
    nlev,
    horizontal_start,
    horizontal_start_1,
):
    """Element-by-element reference matching main-branch scan semantics."""
    array_ns = np
    nedges = e2c.shape[0]
    z_aux1 = array_ns.maximum(topography[e2c[:, 0]], topography[e2c[:, 1]])
    z_aux2 = z_aux1 - EXTRAPOL_DIST

    zdiff_gradp = array_ns.zeros_like(z_mc[e2c])
    jk_field = array_ns.arange(nlev, dtype=np.int32)
    zdiff_gradp[horizontal_start:, :, :] = (
        array_ns.expand_dims(z_me, axis=1)[horizontal_start:, :, :]
        - z_mc[e2c][horizontal_start:, :, :]
    )
    vertidx_gradp = array_ns.broadcast_to(jk_field[None, None, :], (nedges, 2, nlev)).copy()
    vertoffset_gradp = array_ns.broadcast_to(jk_field[None, None, :], (nedges, 2, nlev)).copy()

    for je in range(horizontal_start, nedges):
        for jk in range(int(flat_idx[je]) + 1, nlev):
            param = array_ns.zeros((nlev,), dtype=bool)
            for jk1 in range(int(flat_idx[je]), nlev):
                if jk1 == nlev - 1 or (
                    z_me[je, jk] <= z_ifc[e2c[je, 0], jk1]
                    and z_me[je, jk] >= z_ifc[e2c[je, 0], jk1 + 1]
                ):
                    param[jk1] = True
            idx = int(array_ns.where(param)[0][0])
            vertidx_gradp[je, 0, jk] = idx
            zdiff_gradp[je, 0, jk] = z_me[je, jk] - z_mc[e2c[je, 0], idx]

        jk_start = int(flat_idx[je])
        for jk in range(int(flat_idx[je]) + 1, nlev):
            for jk1 in range(jk_start, nlev):
                if jk1 == nlev - 1 or (
                    z_me[je, jk] <= z_ifc[e2c[je, 1], jk1]
                    and z_me[je, jk] >= z_ifc[e2c[je, 1], jk1 + 1]
                ):
                    vertidx_gradp[je, 1, jk] = jk1
                    zdiff_gradp[je, 1, jk] = z_me[je, jk] - z_mc[e2c[je, 1], jk1]
                    jk_start = jk1
                    break

    for je in range(horizontal_start_1, nedges):
        jk_start = int(flat_idx[je])
        for jk in range(int(flat_idx[je]) + 1, nlev):
            if z_me[je, jk] < z_aux2[je]:
                for jk1 in range(jk_start, nlev):
                    if jk1 == nlev - 1 or (
                        z_aux2[je] <= z_ifc[e2c[je, 0], jk1]
                        and z_aux2[je] >= z_ifc[e2c[je, 0], jk1 + 1]
                    ):
                        vertidx_gradp[je, 0, jk] = jk1
                        zdiff_gradp[je, 0, jk] = z_aux2[je] - z_mc[e2c[je, 0], jk1]
                        jk_start = jk1
                        break

        jk_start = int(flat_idx[je])
        for jk in range(int(flat_idx[je]) + 1, nlev):
            if z_me[je, jk] < z_aux2[je]:
                for jk1 in range(jk_start, nlev):
                    if jk1 == nlev - 1 or (
                        z_aux2[je] <= z_ifc[e2c[je, 1], jk1]
                        and z_aux2[je] >= z_ifc[e2c[je, 1], jk1 + 1]
                    ):
                        vertidx_gradp[je, 1, jk] = jk1
                        zdiff_gradp[je, 1, jk] = z_aux2[je] - z_mc[e2c[je, 1], jk1]
                        jk_start = jk1
                        break

    vertoffset_gradp = vertidx_gradp - vertoffset_gradp
    return zdiff_gradp, vertoffset_gradp


def run_variant(fn, e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1):
    return fn(
        e2c=e2c,
        z_me=z_me,
        z_mc=z_mc,
        z_ifc=z_ifc,
        flat_idx=flat_idx,
        topography=topography,
        nlev=nlev,
        horizontal_start=hs,
        horizontal_start_1=hs1,
    )


def _reference_scan_outputs(e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1):
    """Defensive Python reference: first-match scan + D6 assembly on numpy.

    This is independent of the successor-table machinery and is used as an
    oracle for the cupy exact_v3 kernel path.  It assumes E3 holds for the
    input, which is true for the standard Tier-A generator inputs.
    """
    nedges = e2c.shape[0]
    z_aux1 = np.maximum(topography[e2c[:, 0]], topography[e2c[:, 1]])
    z_aux2 = z_aux1 - EXTRAPOL_DIST
    fi = flat_idx.astype(np.int64)
    e2c_0 = e2c[:, 0].astype(np.int64)
    e2c_1 = e2c[:, 1].astype(np.int64)

    z_ifc_e0 = np.asarray(z_ifc[e2c_0, :], dtype=np.float64)
    z_ifc_e1 = np.asarray(z_ifc[e2c_1, :], dtype=np.float64)
    z_me_np = np.asarray(z_me, dtype=np.float64)

    jk_idx = np.arange(nlev, dtype=np.int64)[None, :]
    edge_hs_mask = np.arange(nedges, dtype=np.int64) >= hs
    edge_hs1_mask = np.arange(nedges, dtype=np.int64) >= hs1
    valid_jk = (jk_idx > fi[:, None]) & edge_hs_mask[:, None]
    phase2_active = valid_jk & (z_me_np < z_aux2[:, None]) & edge_hs1_mask[:, None]

    zdiff_gradp = np.zeros_like(z_mc[e2c])
    zdiff_gradp[hs:, :, :] = np.expand_dims(z_me_np, axis=1)[hs:, :, :] - z_mc[e2c][hs:, :, :]
    vertoffset_gradp = np.zeros((nedges, 2, nlev), dtype=np.int32)

    jk1_0 = _first_match_scan_reference(z_ifc_e0, z_me_np, fi)
    zdiff_gradp[:, 0, :] = np.where(
        valid_jk,
        z_me_np - np.take_along_axis(z_mc[e2c_0], jk1_0, axis=1),
        zdiff_gradp[:, 0, :],
    )
    vertoffset_gradp[:, 0, :] = np.where(
        valid_jk,
        (jk1_0 - jk_idx).astype(np.int32),
        vertoffset_gradp[:, 0, :],
    )

    jk1_1 = _first_match_scan_reference(z_ifc_e1, z_me_np, fi)
    zdiff_gradp[:, 1, :] = np.where(
        valid_jk,
        z_me_np - np.take_along_axis(z_mc[e2c_1], jk1_1, axis=1),
        zdiff_gradp[:, 1, :],
    )
    vertoffset_gradp[:, 1, :] = np.where(
        valid_jk,
        (jk1_1 - jk_idx).astype(np.int32),
        vertoffset_gradp[:, 1, :],
    )

    if hs1 < nedges:
        z_aux2_v = z_aux2[:, None]
        jk1_aux_0 = _first_match_scan_reference(z_ifc_e0, z_aux2_v, fi)
        zdiff_gradp[:, 0, :] = np.where(
            phase2_active,
            z_aux2_v - np.take_along_axis(z_mc[e2c_0], jk1_aux_0, axis=1),
            zdiff_gradp[:, 0, :],
        )
        vertoffset_gradp[:, 0, :] = np.where(
            phase2_active,
            (jk1_aux_0 - jk_idx).astype(np.int32),
            vertoffset_gradp[:, 0, :],
        )

        jk1_aux_1 = _first_match_scan_reference(z_ifc_e1, z_aux2_v, fi)
        zdiff_gradp[:, 1, :] = np.where(
            phase2_active,
            z_aux2_v - np.take_along_axis(z_mc[e2c_1], jk1_aux_1, axis=1),
            zdiff_gradp[:, 1, :],
        )
        vertoffset_gradp[:, 1, :] = np.where(
            phase2_active,
            (jk1_aux_1 - jk_idx).astype(np.int32),
            vertoffset_gradp[:, 1, :],
        )

    return zdiff_gradp, vertoffset_gradp


def fingerprint_info(flat_idx, nlev, z_me, z_aux2, z_ifc, e2c, hs1, nedges):
    bc = np.bincount(np.asarray(flat_idx), minlength=nlev)
    bins = {
        "0": int(bc[0]),
        "1..9": int(bc[1:10].sum()),
        "10..29": int(bc[10:30].sum()),
        "30..49": int(bc[30:50].sum()),
        "50..59": int(bc[50:60].sum()),
    }
    jk = np.arange(nlev)[None, :]
    nudg = np.arange(nedges)[:, None] >= hs1
    z_me_np = np.asarray(z_me if isinstance(z_me, np.ndarray) else z_me.get())
    z_aux2_np = np.asarray(z_aux2 if isinstance(z_aux2, np.ndarray) else z_aux2.get())
    flat_idx_np = np.asarray(flat_idx if isinstance(flat_idx, np.ndarray) else flat_idx.get())
    p2 = (jk > flat_idx_np[:, None]) & nudg & (z_me_np < z_aux2_np[:, None])
    ep = _endpoint_count(e2c, z_ifc, flat_idx, z_aux2, hs1, nedges, nlev)
    return {
        "bins": bins,
        "phase2_active": int(p2.any(1).sum()),
        "endpoint_count": ep,
    }


def build_endpoint_forcing_inputs():
    nedges = 4
    ncells = 4
    nlev = 8
    hs = 0
    hs1 = 2
    e0 = 2
    cell0 = 0
    cell1 = 1

    topography = np.array([1000.0, 1000.0, 2000.0, 1500.0], dtype=np.float64)
    topography[cell1] = FULL_HEIGHT - (nlev - 2) * (FULL_HEIGHT - topography[cell0]) / nlev + 6.0

    z_ifc = np.empty((ncells, nlev + 1), dtype=np.float64)
    for c in range(ncells):
        top = topography[c]
        for k in range(nlev + 1):
            z_ifc[c, k] = FULL_HEIGHT - k * (FULL_HEIGHT - top) / nlev

    z_mc = 0.5 * (z_ifc[:, :-1] + z_ifc[:, 1:])
    c_lin_e = np.full((nedges, 2), 0.5, dtype=np.float64)
    e2c = np.array([[0, 1], [2, 3], [0, 1], [2, 3]], dtype=np.int64)
    z_me = np.sum(z_mc[e2c] * c_lin_e[:, :, None], axis=1)

    flat_idx = np.zeros((nedges,), dtype=np.int32)
    flat_idx[e0] = nlev - 2
    z_me[e0, nlev - 1] = z_ifc[cell0, nlev - 1]

    return e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1, e0, cell0


def run_endpoint_forcing():
    e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1, e0, cell0 = (
        build_endpoint_forcing_inputs()
    )

    z_aux1 = np.maximum(topography[e2c[:, 0]], topography[e2c[:, 1]])
    z_aux2 = z_aux1 - EXTRAPOL_DIST

    assert flat_idx[e0] < nlev - 1
    assert z_aux2[e0] > z_ifc[cell0, flat_idx[e0]]
    for c in (0, 1):
        for jk in range(flat_idx[e0] + 1, nlev):
            assert z_me[e0, jk] <= z_ifc[e2c[e0, c], flat_idx[e0]]
    assert e0 >= hs1
    assert z_me[e0, nlev - 1] < z_aux2[e0]

    golden_zdiff, golden_vert = main_reference(
        e2c=e2c,
        z_me=z_me,
        z_mc=z_mc,
        z_ifc=z_ifc,
        flat_idx=flat_idx,
        topography=topography,
        nlev=nlev,
        horizontal_start=hs,
        horizontal_start_1=hs1,
    )

    candidate_zdiff, candidate_vert = run_variant(
        compute_zdiff_gradp_v2, e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1
    )
    exact_zdiff, exact_vert = run_variant(
        compute_zdiff_gradp_exact, e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1
    )
    exact2_zdiff, exact2_vert = run_variant(
        compute_zdiff_gradp_exact_v2, e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1
    )
    exact3_zdiff, exact3_vert = run_variant(
        compute_zdiff_gradp_exact_v3, e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1
    )
    dispatch_zdiff, dispatch_vert = run_variant(
        compute_zdiff_gradp_dispatch, e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1
    )
    baseline_zdiff, baseline_vert = run_variant(
        compute_zdiff_gradp, e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1
    )

    candidate_matches = np.allclose(candidate_zdiff, golden_zdiff) and np.array_equal(
        candidate_vert, golden_vert
    )
    exact_matches = np.allclose(exact_zdiff, golden_zdiff) and np.array_equal(
        exact_vert, golden_vert
    )
    exact2_matches = np.allclose(exact2_zdiff, golden_zdiff) and np.array_equal(
        exact2_vert, golden_vert
    )
    exact3_matches = np.allclose(exact3_zdiff, golden_zdiff) and np.array_equal(
        exact3_vert, golden_vert
    )
    dispatch_matches = np.allclose(dispatch_zdiff, golden_zdiff) and np.array_equal(
        dispatch_vert, golden_vert
    )
    baseline_diverges = not np.allclose(baseline_zdiff, golden_zdiff) or not np.array_equal(
        baseline_vert, golden_vert
    )
    ep = int(
        (z_aux2[e0] > z_ifc[e2c[e0, 0], flat_idx[e0]])
        + (z_aux2[e0] > z_ifc[e2c[e0, 1], flat_idx[e0]])
    )
    return {
        "endpoint_count": ep,
        "candidate_matches_golden": bool(candidate_matches),
        "baseline_diverges": bool(baseline_diverges),
        "exact_matches_golden": bool(exact_matches),
        "exact2_matches_golden": bool(exact2_matches),
        "exact2_path": _zdiff_mod._LAST_EXACT_V2_PATH,
        "exact3_matches_golden": bool(exact3_matches),
        "exact3_path": _zdiff_mod._LAST_EXACT_V3_PATH,
        "dispatch_matches_golden": bool(dispatch_matches),
        "dispatch_path": _zdiff_mod._LAST_DISPATCH_PATH,
    }


def build_p1_interior_tie_inputs():
    """P1: interior z_me/z_ifc tie; E1 holds."""
    nedges = 4
    ncells = 4
    nlev = 8
    hs = 0
    hs1 = 2
    e0 = 2
    cell0 = 0
    fi = 2
    tie_level = fi + 1

    topography = np.array([1000.0, 1000.0, 2000.0, 1500.0], dtype=np.float64)
    z_ifc = np.empty((ncells, nlev + 1), dtype=np.float64)
    for c in range(ncells):
        top = topography[c]
        for k in range(nlev + 1):
            z_ifc[c, k] = FULL_HEIGHT - k * (FULL_HEIGHT - top) / nlev

    z_mc = 0.5 * (z_ifc[:, :-1] + z_ifc[:, 1:])
    c_lin_e = np.full((nedges, 2), 0.5, dtype=np.float64)
    e2c = np.array([[0, 1], [2, 3], [0, 1], [2, 3]], dtype=np.int64)
    z_me = np.sum(z_mc[e2c] * c_lin_e[:, :, None], axis=1)
    # Query exactly equals an interior interface on the forced edge, between fi and nlev.
    # z_ifc itself remains strictly decreasing (E1 holds); the tie is z_me == z_ifc.
    z_me[e0, fi + 1] = z_ifc[cell0, tie_level]

    flat_idx = np.full((nedges,), fi, dtype=np.int32)
    flat_idx[e0] = fi

    return e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1, e0, cell0


def build_p2_zero_thickness_inputs():
    """P2: one zero-thickness level; all finite, query between neighbors."""
    nedges = 4
    ncells = 4
    nlev = 8
    hs = 0
    hs1 = 2
    e0 = 2
    cell0 = 0
    fi = 1
    thin_level = 4

    topography = np.array([1000.0, 1000.0, 2000.0, 1500.0], dtype=np.float64)
    z_ifc = np.empty((ncells, nlev + 1), dtype=np.float64)
    for c in range(ncells):
        top = topography[c]
        for k in range(nlev + 1):
            z_ifc[c, k] = FULL_HEIGHT - k * (FULL_HEIGHT - top) / nlev

    # Zero-thickness level in cell0.
    z_ifc[cell0, thin_level + 1] = z_ifc[cell0, thin_level]

    z_mc = 0.5 * (z_ifc[:, :-1] + z_ifc[:, 1:])
    c_lin_e = np.full((nedges, 2), 0.5, dtype=np.float64)
    e2c = np.array([[0, 1], [2, 3], [0, 1], [2, 3]], dtype=np.int64)
    z_me = np.sum(z_mc[e2c] * c_lin_e[:, :, None], axis=1)
    # Query strictly between surrounding interfaces.
    z_me[e0, fi + 1] = 0.5 * (z_ifc[cell0, thin_level - 1] + z_ifc[cell0, thin_level + 2])

    flat_idx = np.full((nedges,), fi, dtype=np.int32)

    return e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1, e0, cell0


def build_p3_e3_violation_inputs():
    """P3: z_me strictly increasing over [fi+1, nlev-1] on one edge; E1 holds."""
    nedges = 4
    ncells = 4
    nlev = 8
    hs = 0
    hs1 = 2
    e0 = 2
    cell0 = 0
    fi = 2

    topography = np.array([1000.0, 1000.0, 2000.0, 1500.0], dtype=np.float64)
    z_ifc = np.empty((ncells, nlev + 1), dtype=np.float64)
    for c in range(ncells):
        top = topography[c]
        for k in range(nlev + 1):
            z_ifc[c, k] = FULL_HEIGHT - k * (FULL_HEIGHT - top) / nlev

    z_mc = 0.5 * (z_ifc[:, :-1] + z_ifc[:, 1:])
    c_lin_e = np.full((nedges, 2), 0.5, dtype=np.float64)
    e2c = np.array([[0, 1], [2, 3], [0, 1], [2, 3]], dtype=np.int64)
    z_me = np.sum(z_mc[e2c] * c_lin_e[:, :, None], axis=1)

    flat_idx = np.full((nedges,), fi, dtype=np.int32)

    # Force strictly increasing z_me over the active segment, crossing bracket
    # boundaries upward so the carry semantics differ from a fresh per-jk scan.
    z_me[e0, fi + 1] = 0.5 * (z_ifc[cell0, fi + 1] + z_ifc[cell0, fi + 2])
    z_me[e0, fi + 2] = 0.5 * (z_ifc[cell0, fi] + z_ifc[cell0, fi + 1])
    z_me[e0, fi + 3] = 0.5 * (z_ifc[cell0, fi - 1] + z_ifc[cell0, fi])
    z_me[e0, fi + 4] = 0.5 * (z_ifc[cell0, fi - 2] + z_ifc[cell0, fi - 1])
    z_me[e0, nlev - 1] = z_ifc[cell0, 0] - 100.0

    return e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1, e0, 0


def run_weird_input_probe(builder, name):
    """Run one weird-input probe; return record dict per the amended schema."""
    e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1, e0, cell0 = builder()

    golden_zdiff, golden_vert = main_reference(
        e2c=e2c,
        z_me=z_me,
        z_mc=z_mc,
        z_ifc=z_ifc,
        flat_idx=flat_idx,
        topography=topography,
        nlev=nlev,
        horizontal_start=hs,
        horizontal_start_1=hs1,
    )

    os.environ["ICON4PY_VALIDATE_ZDIFF_GRADP"] = "1"

    exact_zdiff, exact_vert = run_variant(
        compute_zdiff_gradp_exact, e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1
    )
    exact_matches = np.allclose(exact_zdiff, golden_zdiff) and np.array_equal(
        exact_vert, golden_vert
    )
    if not exact_matches:
        _log(f"Probe {name}: exact does not match golden")
        sys.exit(1)

    exact2_zdiff, exact2_vert = run_variant(
        compute_zdiff_gradp_exact_v2, e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1
    )
    exact2_matches = np.allclose(exact2_zdiff, golden_zdiff) and np.array_equal(
        exact2_vert, golden_vert
    )
    exact2_path = _zdiff_mod._LAST_EXACT_V2_PATH
    exact3_zdiff, exact3_vert = run_variant(
        compute_zdiff_gradp_exact_v3, e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1
    )
    exact3_matches = np.allclose(exact3_zdiff, golden_zdiff) and np.array_equal(
        exact3_vert, golden_vert
    )
    exact3_path = _zdiff_mod._LAST_EXACT_V3_PATH
    if not exact3_matches:
        _log(f"Probe {name}: exact_v3 does not match golden")
        sys.exit(1)
    if not exact2_matches:
        _log(f"Probe {name}: exact_v2 does not match golden")
        sys.exit(1)

    dispatch_zdiff, dispatch_vert = run_variant(
        compute_zdiff_gradp_dispatch, e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1
    )
    dispatch_matches = np.allclose(dispatch_zdiff, golden_zdiff) and np.array_equal(
        dispatch_vert, golden_vert
    )
    dispatch_path = _zdiff_mod._LAST_DISPATCH_PATH

    record = {
        "name": name,
        "exact_matches_golden": True,
        "exact2_matches_golden": True,
        "exact2_path": exact2_path,
        "exact3_matches_golden": True,
        "exact3_path": exact3_path,
        "dispatch_matches_golden": bool(dispatch_matches),
        "dispatch_path": dispatch_path,
    }

    if name == "P1":
        candidate_zdiff, candidate_vert = run_variant(
            compute_zdiff_gradp_v2, e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1
        )
        v2_diverges = not (
            np.allclose(candidate_zdiff, golden_zdiff)
            and np.array_equal(candidate_vert, golden_vert)
        )
        if not v2_diverges:
            _log("Probe P1: v2 unexpectedly matched golden")
            sys.exit(1)
        record["v2_diverges"] = True
        if dispatch_matches:
            _log("Probe P1: dispatch unexpectedly matched golden")
            sys.exit(1)
        if dispatch_path != "fast":
            _log("Probe P1: dispatch did not route to v2 fast path")
            sys.exit(1)
        if exact3_path != "fast":
            _log("Probe P1: exact_v3 did not use fast path")
            sys.exit(1)
    elif name == "P2":
        try:
            run_variant(
                compute_zdiff_gradp_v2, e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1
            )
            v2_raised = False
        except ValueError:
            v2_raised = True
        if not v2_raised:
            _log("Probe P2: v2 did not raise")
            sys.exit(1)
        record["v2_raised"] = True
        if not dispatch_matches:
            _log("Probe P2: dispatch did not match golden")
            sys.exit(1)
        if dispatch_path != "exact":
            _log("Probe P2: dispatch did not route to exact_v2")
            sys.exit(1)

    elif name == "P3":
        try:
            run_variant(
                compute_zdiff_gradp_v2, e2c, z_me, z_mc, z_ifc, flat_idx, topography, nlev, hs, hs1
            )
            v2_raised = False
        except ValueError:
            v2_raised = True
        if not v2_raised:
            _log("Probe P3: v2 did not raise")
            sys.exit(1)
        if exact2_path != "carry":
            _log("Probe P3: exact_v2 did not use carry path")
            sys.exit(1)
        if dispatch_path != "exact":
            _log("Probe P3: dispatch did not route to exact_v2")
            sys.exit(1)
        if exact3_path != "carry":
            _log("Probe P3: exact_v3 did not use carry path")
            sys.exit(1)
        record["exact3_path"] = "carry"
        record["v2_raised"] = True
        record["exact2_path"] = "carry"
        record["dispatch_path"] = "exact"

    else:
        raise RuntimeError(f"Unknown probe {name}")

    return record


def count_mismatches(a, b):
    a_np = np.asarray(a if isinstance(a, np.ndarray) else a.get())
    b_np = np.asarray(b if isinstance(b, np.ndarray) else b.get())
    return int((a_np != b_np).sum())


def count_mismatches_close(a, b):
    a_np = np.asarray(a if isinstance(a, np.ndarray) else a.get())
    b_np = np.asarray(b if isinstance(b, np.ndarray) else b.get())
    return int((~np.isclose(a_np, b_np)).sum())


