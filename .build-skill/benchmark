def run_profile_exact(*, dev: bool):
    """Run exact-variant phase profiler at Tier B scale."""
    if dev:
        nedges, ncells, nlev = 49152, 32768, 60
    else:
        nedges, ncells, nlev = 491520, 327680, 60

    e2c, z_me, z_mc, z_ifc, flat_idx, topography, hs, hs1 = build_inputs(nedges, ncells, nlev, SEED)
    z_aux2 = z_aux2_from(topography, e2c)
    info = fingerprint_info(flat_idx, nlev, z_me, z_aux2, z_ifc, e2c, hs1, nedges)
    if info["endpoint_count"] != 0:
        _log(f"Profile exact endpoint count nonzero: {info['endpoint_count']}")
        sys.exit(1)

    backend_name = "numpy"
    try:
        import cupy as cp

        backend_name = "cupy"
        array_ns = cp
        e2c_b, z_me_b, z_mc_b, z_ifc_b, flat_idx_b, topography_b = _to_namespace(
            [e2c, z_me, z_mc, z_ifc, flat_idx, topography], cp
        )
    except ImportError:
        array_ns = np
        e2c_b, z_me_b, z_mc_b, z_ifc_b, flat_idx_b, topography_b = (
            e2c,
            z_me,
            z_mc,
            z_ifc,
            flat_idx,
            topography,
        )

    mem_per_edge = nlev * 2 * (nlev + 1)
    chunk_size = max(1, min(nedges, (256 * 1024 * 1024) // mem_per_edge))

    # Total exact variant time.
    _sync(array_ns)
    t0 = time.perf_counter()
    exact_result = compute_zdiff_gradp_exact(
        e2c=e2c_b,
        z_me=z_me_b,
        z_mc=z_mc_b,
        z_ifc=z_ifc_b,
        flat_idx=flat_idx_b,
        topography=topography_b,
        nlev=nlev,
        horizontal_start=hs,
        horizontal_start_1=hs1,
        chunk_size=chunk_size,
    )
    _sync(array_ns)
    exact_total_ms = (time.perf_counter() - t0) * 1000.0

    # Exact per-phase timing.
    zdiff_gradp_prof, vertoffset_gradp_prof, timers, chunk_size = _profile_exact_variant(
        e2c_b, z_me_b, z_mc_b, z_ifc_b, flat_idx_b, topography_b, nlev, hs, hs1, chunk_size
    )
    profile_result = (zdiff_gradp_prof, vertoffset_gradp_prof)
    exact_matches = np.allclose(
        _to_numpy(exact_result[0]), _to_numpy(profile_result[0])
    ) and np.array_equal(_to_numpy(exact_result[1]), _to_numpy(profile_result[1]))
    if not exact_matches:
        _log("Profile exact: phased result does not match compute_zdiff_gradp_exact")
        sys.exit(1)

    # Total v2 variant time.
    _sync(array_ns)
    t0 = time.perf_counter()
    v2_result = compute_zdiff_gradp_v2(
        e2c=e2c_b,
        z_me=z_me_b,
        z_mc=z_mc_b,
        z_ifc=z_ifc_b,
        flat_idx=flat_idx_b,
        topography=topography_b,
        nlev=nlev,
        horizontal_start=hs,
        horizontal_start_1=hs1,
    )
    _sync(array_ns)
    v2_total_ms = (time.perf_counter() - t0) * 1000.0

    # V2 per-phase timing.
    zdiff_gradp_v2prof, vertoffset_gradp_v2prof, v2_timers = _profile_v2_variant(
        e2c_b, z_me_b, z_mc_b, z_ifc_b, flat_idx_b, topography_b, nlev, hs, hs1
    )
    v2_profile_result = (zdiff_gradp_v2prof, vertoffset_gradp_v2prof)

    v2_matches = np.allclose(
        _to_numpy(v2_result[0]), _to_numpy(v2_profile_result[0])
    ) and np.array_equal(_to_numpy(v2_result[1]), _to_numpy(v2_profile_result[1]))
    if not v2_matches:
        _log("Profile exact: phased v2 result does not match compute_zdiff_gradp_v2")
        sys.exit(1)

    assumed_launch_latency_us = 10.0
    total_carry_ops = (
        timers["carry_loop_p1_c1_ops"]
        + timers["carry_loop_p2_c0_ops"]
        + timers["carry_loop_p2_c1_ops"]
    )
    total_carry_ms = (
        timers["carry_loop_p1_c1_ms"]
        + timers["carry_loop_p2_c0_ms"]
        + timers["carry_loop_p2_c1_ms"]
    )
    launch_latency_ms = total_carry_ops * assumed_launch_latency_us / 1000.0

    return {
        "iteration_id": os.environ.get("BUILD_SKILL_ITERATION_ID", "iter-002"),
        "mode": "profile-exact",
        "dev": dev,
        "backend": backend_name,
        "nedges": nedges,
        "ncells": ncells,
        "nlev": nlev,
        "chunk_size": chunk_size,
        "exact_total_ms": exact_total_ms,
        "v2_total_ms": v2_total_ms,
        "exact_matches_profile": bool(exact_matches),
        "v2_matches_profile": bool(v2_matches),
        "assumed_launch_latency_us": assumed_launch_latency_us,
        "total_carry_ops": total_carry_ops,
        "total_carry_ms": total_carry_ms,
        "estimated_launch_latency_ms": launch_latency_ms,
        "estimated_launch_latency_share_carry_pct": (
            (launch_latency_ms / total_carry_ms * 100.0) if total_carry_ms > 0 else 0.0
        ),
        "estimated_launch_latency_share_exact_pct": (
            (launch_latency_ms / exact_total_ms * 100.0) if exact_total_ms > 0 else 0.0
        ),
        **timers,
        **{f"v2_{k}": v for k, v in v2_timers.items()},
    }


